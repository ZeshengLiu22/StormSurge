+                    train.main(command)
+                self.assertEqual(observed.call_args.kwargs, dict(factor=.3, patience=7, threshold=.02,
+                                                                  cooldown=4, min_lr=.00002))
+            snapshot = (root / 'run' / 'config_used.sh').read_text()
+            self.assertIn('ROP_COOLDOWN=4', snapshot)
