-
-        self.act = nn.LeakyReLU(0.1, inplace=True)
-        self.dropout = float(dropout)
-
-        self.lstm = nn.LSTM(
-            input_size=hidden_channels,
-            hidden_size=temporal_hidden,
-            num_layers=1,
-            batch_first=True,
