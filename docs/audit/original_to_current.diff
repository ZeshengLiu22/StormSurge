-            h = self.act(h)
-            h = F.dropout(h, p=self.dropout, training=self.training)
-
-        # Return the same node-token interface as GraphSAGE: (B*N, hidden_channels).
-        return h.permute(0, 2, 3, 1).contiguous().reshape(batch_size * grid_h * grid_w, -1)
