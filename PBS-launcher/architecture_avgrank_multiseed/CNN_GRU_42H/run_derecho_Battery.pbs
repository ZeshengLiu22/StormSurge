#!/bin/bash -l
# Three sequential fresh runs: CNN_GRU_42H, Battery; seeds 42, 123, 2026.
# Submit: qsub PBS-launcher/architecture_avgrank_multiseed/CNN_GRU_42H/run_derecho_Battery.pbs
# Preview only: DRY_RUN=1 bash PBS-launcher/architecture_avgrank_multiseed/CNN_GRU_42H/run_derecho_Battery.pbs
#PBS -N ms_cg42_Battery
#PBS -A ULHI0005
#PBS -q main@desched1
#PBS -l job_priority=economy
#PBS -l select=1:ncpus=64:mem=487GB:mpiprocs=4:ompthreads=1:ngpus=4
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /glade/u/home/zel/scratch/StormSurge/PBS-launcher/architecture_avgrank_multiseed/CNN_GRU_42H/

set -euo pipefail
export NODE_ATTENTION_BACKEND="${NODE_ATTENTION_BACKEND:-math}"
export WEIGHT_DECAY_POLICY="${WEIGHT_DECAY_POLICY:-module}"
PROJECT_ROOT=/glade/u/home/zel/scratch/StormSurge
cd -- "${PROJECT_ROOT}"
export DRY_RUN="${DRY_RUN:-0}"
case "${DRY_RUN}" in
  0|1) ;;
  *) echo '[FATAL] DRY_RUN must be 0 or 1.' >&2; exit 2 ;;
esac

export PYTHON_BIN="${PYTHON_BIN:-/glade/work/zel/conda-envs/derecho-ml/bin/python}"
export S0_PYTHON_BIN="${PYTHON_BIN}"
export USE_TMUX=0
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export PYTHONUNBUFFERED=1
unset SLURM_NTASKS_PER_NODE SLURM_JOB_ID PACT_RUNSTAMP

# The trainer uses seed + rank; these three four-rank seed ranges do not overlap.
seeds=(42 123 2026)
configs=()
for seed in "${seeds[@]}"; do
  config="${PROJECT_ROOT}/configs/architecture_avgrank_multiseed/CNN_GRU_42H/Battery/train_config_NCEP_Battery_CNN_GRU_42H_seed${seed}_G0_T0000_EP0000.sh"
  if [[ ! -r "${config}" ]]; then
    printf '[FATAL] Missing config: %s\n' "${config}" >&2
    exit 2
  fi
  configs+=("${config}")
done
if [[ ! -x "${PYTHON_BIN}" ]]; then
  printf '[FATAL] Python is not executable: %s\n' "${PYTHON_BIN}" >&2
  exit 2
fi

if [[ "${DRY_RUN}" != 1 ]]; then
  if [[ -z "${PBS_JOBID:-}" ]]; then
    echo '[FATAL] Submit with qsub; use DRY_RUN=1 for a login-node preview.' >&2
    exit 2
  fi
  module load cuda/12.9.0
  export TMPDIR="/glade/derecho/scratch/zel/tmp/pact-avgrank-${PBS_JOBID}"
  mkdir -p -- "${TMPDIR}"
  "${PYTHON_BIN}" - <<'PYTHON'
import sys
import torch
import torch.distributed as dist
import torch_geometric

if not torch.cuda.is_available() or torch.cuda.device_count() != 4:
    raise SystemExit('[FATAL] Exactly four visible CUDA GPUs are required.')
if not dist.is_available() or not dist.is_nccl_available():
    raise SystemExit('[FATAL] PyTorch distributed/NCCL support is required.')
for index in range(4):
    if torch.cuda.get_device_capability(index)[0] < 8:
        raise SystemExit('[FATAL] These BF16/TF32 configs require Ampere or newer GPUs.')
    print(f'[GPU {index}] {torch.cuda.get_device_name(index)}')
print(f'[RUNTIME] {sys.executable}; torch={torch.__version__}; CUDA={torch.version.cuda}; PyG={torch_geometric.__version__}')
PYTHON
fi

printf '[PBS] job=%s model=CNN_GRU_42H station=Battery runs=3 GPUs/run=4 DRY_RUN=%s\n' \
  "${PBS_JOBID:-dry-run}" "${DRY_RUN}"
start_seconds=${SECONDS}
for index in "${!configs[@]}"; do
  printf '[RUN %d/3] seed=%s config=%s\n' \
    "$((index + 1))" "${seeds[index]}" "${configs[index]}"
  # One four-GPU run at a time. As in the original sweep, a failure stops this job.
  bash "${PROJECT_ROOT}/train.sh" "${configs[index]}"
done
printf '[COMPLETE] model=CNN_GRU_42H station=Battery runs=3 elapsed=%ss DRY_RUN=%s\n' \
  "$((SECONDS - start_seconds))" "${DRY_RUN}"
