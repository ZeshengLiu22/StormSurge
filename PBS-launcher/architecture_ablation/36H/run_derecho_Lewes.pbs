#!/bin/bash -l
# Eight sequential architecture runs for Lewes, history=36H.
# Submit from Derecho: qsub PBS-launcher/architecture_ablation/36H/run_derecho_Lewes.pbs
#PBS -N aa36_Lewes
#PBS -A ULHI0005
#PBS -q preempt@desched1
#PBS -l select=1:ncpus=64:mem=487GB:mpiprocs=4:ompthreads=1:ngpus=4
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /glade/u/home/zel/scratch/StormSurge/PBS-launcher/architecture_ablation/36H/

set -euo pipefail
export NODE_ATTENTION_BACKEND="${NODE_ATTENTION_BACKEND:-math}"
export WEIGHT_DECAY_POLICY="${WEIGHT_DECAY_POLICY:-module}"
cd /glade/u/home/zel/scratch/StormSurge
exec bash PBS-launcher/architecture_ablation/run_station.sh Lewes 36H
