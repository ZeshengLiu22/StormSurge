#!/bin/bash -l
# Eight sequential architecture runs for Boston, history=6H.
# Submit from Derecho: qsub PBS-launcher/architecture_ablation/6H/run_derecho_Boston.pbs
#PBS -N aa6_Boston
#PBS -A ULHI0005
#PBS -q preempt@desched1
#PBS -l select=1:ncpus=64:mem=487GB:mpiprocs=4:ompthreads=1:ngpus=4
#PBS -l walltime=03:30:00
#PBS -j oe
#PBS -o /glade/u/home/zel/scratch/StormSurge/PBS-launcher/architecture_ablation/6H/

set -euo pipefail
export NODE_ATTENTION_BACKEND="${NODE_ATTENTION_BACKEND:-math}"
export WEIGHT_DECAY_POLICY="${WEIGHT_DECAY_POLICY:-module}"
cd /glade/u/home/zel/scratch/StormSurge
exec bash PBS-launcher/architecture_ablation/run_station.sh Boston 6H
