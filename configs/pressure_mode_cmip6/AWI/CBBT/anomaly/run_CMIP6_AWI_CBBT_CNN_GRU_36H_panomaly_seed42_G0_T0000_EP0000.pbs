#!/bin/bash -l
# One independent training run: CMIP6_AWI_CBBT_CNN_GRU_36H_panomaly_seed42_G0_T0000_EP0000.
# Preview: DRY_RUN=1 bash /glade/u/home/zel/scratch/StormSurge/configs/pressure_mode_cmip6/AWI/CBBT/anomaly/run_CMIP6_AWI_CBBT_CNN_GRU_36H_panomaly_seed42_G0_T0000_EP0000.pbs
#PBS -N pc6_a_c_a_s42
#PBS -A ULHI0006
#PBS -q main@desched1
#PBS -l job_priority=economy
#PBS -l select=1:ncpus=64:mem=487GB:mpiprocs=4:ompthreads=1:ngpus=4
#PBS -l walltime=02:00:00
#PBS -r n
#PBS -j oe
#PBS -o /glade/u/home/zel/scratch/StormSurge/configs/pressure_mode_cmip6/pbs_logs/

set -euo pipefail
PROJECT_ROOT=/glade/u/home/zel/scratch/StormSurge
CONFIG="${PROJECT_ROOT}/configs/pressure_mode_cmip6/AWI/CBBT/anomaly/train_config_CMIP6_AWI_CBBT_CNN_GRU_36H_panomaly_seed42_G0_T0000_EP0000.sh"
cd -- "${PROJECT_ROOT}"
export DRY_RUN="${DRY_RUN:-0}"
case "${DRY_RUN}" in
  0|1) ;;
  *) echo '[FATAL] DRY_RUN must be 0 or 1.' >&2; exit 2 ;;
esac
export PYTHON_BIN="${PYTHON_BIN:-/glade/work/zel/conda-envs/derecho-ml/bin/python}"
export S0_PYTHON_BIN="${PYTHON_BIN}"
export USE_TMUX=0
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export PYTHONUNBUFFERED=1
unset SLURM_NTASKS_PER_NODE SLURM_JOB_ID PACT_RUNSTAMP
[[ -r "${CONFIG}" ]] || { echo "[FATAL] Missing config: ${CONFIG}" >&2; exit 2; }
[[ -x "${PYTHON_BIN}" ]] || { echo "[FATAL] Missing Python: ${PYTHON_BIN}" >&2; exit 2; }

if [[ "${DRY_RUN}" != 1 ]]; then
  [[ -n "${PBS_JOBID:-}" ]] || { echo '[FATAL] Submit with qsub; use DRY_RUN=1 for preview.' >&2; exit 2; }
  module load cuda/12.9.0
  export TMPDIR="/glade/derecho/scratch/zel/tmp/pact-cmip6-pressure-${PBS_JOBID}"
  mkdir -p -- "${TMPDIR}"
  "${PYTHON_BIN}" - <<'PYTHON'
import sys
import torch
import torch.distributed as dist
import torch_geometric
if not torch.cuda.is_available() or torch.cuda.device_count() != 4:
    raise SystemExit('[FATAL] Exactly four visible CUDA GPUs are required.')
if not dist.is_available() or not dist.is_nccl_available():
    raise SystemExit('[FATAL] PyTorch distributed/NCCL support is required.')
for index in range(4):
    if torch.cuda.get_device_capability(index)[0] < 8:
        raise SystemExit('[FATAL] BF16/TF32 requires Ampere or newer GPUs.')
    print(f'[GPU {index}] {torch.cuda.get_device_name(index)}')
print(f'[RUNTIME] {sys.executable}; torch={torch.__version__}; CUDA={torch.version.cuda}; PyG={torch_geometric.__version__}')
PYTHON
fi

printf '[PBS] job=%s run=CMIP6_AWI_CBBT_CNN_GRU_36H_panomaly_seed42_G0_T0000_EP0000 runs=1 GPUs=4 DRY_RUN=%s\n' "${PBS_JOBID:-dry-run}" "${DRY_RUN}"
# One history and one learning rate in this config produce exactly one training run.
bash "${PROJECT_ROOT}/train.sh" "${CONFIG}"
printf '[COMPLETE] run=CMIP6_AWI_CBBT_CNN_GRU_36H_panomaly_seed42_G0_T0000_EP0000\n'
